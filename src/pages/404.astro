---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="seccion">
    <div class="contenedor max-w-3xl">
      <p class="antetitulo">Error 404</p>
      <p class="mt-4 font-display text-[clamp(5rem,28vw,11rem)] font-black leading-none" aria-hidden="true">404</p>
      <div class="franja-obra mt-2 max-w-md" aria-hidden="true"></div>
      <h1 class="titulo-seccion mt-8">Aquí no hay nada construido</h1>
      <p class="mt-4 text-lg opacity-80">Puede que el enlace esté mal o que la página se haya movido.</p>
      <p class="mt-8"><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>
