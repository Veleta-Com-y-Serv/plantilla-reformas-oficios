---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Estilo contundente: banda negra con corte en diagonal, migas, etiqueta amarilla, título pesado en mayúsculas,
// texto y botones (presupuesto y llamar); la foto con borde negro y sombra amarilla desplazada. Debajo, el `detalle`
// en párrafos con, al lado, la tarjeta de datos y la caja amarilla de presupuesto; las fotos (`imagenes`) en
// rejilla con borde; y otros servicios de la misma lista en tarjetas con borde grueso.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const presupuesto = seccion('presupuesto') ? enlace('/#presupuesto') : site.boton_cabecera?.url || enlace('/#contacto');
const textoPresupuesto = site.boton_cabecera?.texto || 'Pide presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero presupuesto de ${f.titulo.toLowerCase()}`);
const otras = relacionadas(f, 4);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-oscura diagonal-abajo">
    <div class="contenedor pt-6 md:pt-8">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--foto': f.imagen }]}>
        <div>
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion ficha-titulo">{f.titulo}</h1>
          {f.texto && <p class="titular-texto max-w-2xl">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn" href={presupuesto}>{textoPresupuesto}</a>
            {c.telefono && <a class="btn-sec inline-flex items-center gap-2" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
          </div>
        </div>
        {f.imagen ? (
          <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="ficha-foto aspect-[4/3] w-full object-cover" />
        ) : (
          f.icono && <span class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono} tam={88} /></span>
        )}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {f.datos.length > 0 && (
          <div class="tarjeta">
            <h2 class="text-lg">Datos</h2>
            <dl class="ficha-datos">
              {f.datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="banda-primaria ficha-caja">
          <p class="ficha-caja-titulo">Presupuesto sin compromiso</p>
          <p>Vamos a verlo, medimos y te damos el precio cerrado por escrito.</p>
          <a class="btn-sec" href={presupuesto}>{textoPresupuesto}</a>
          {wa && <a class="ficha-wa" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> Escríbenos por WhatsApp</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="seccion banda-gris" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}, foto ${i + 2}`} ancho={900} alto={675} class="aspect-[4/3] w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo={`Otros ${nombreSeccion.toLowerCase()}`} />
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {otras.map((o) => (
            <li class="tarjeta ficha-otra">
              {o.icono && <span class="icono-caja"><Icono nombre={o.icono} /></span>}
              <h3 class="text-base md:text-lg"><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="text-[.95rem] leading-snug opacity-80">{o.texto}</p>}
              <span class="ficha-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .6rem; font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  .migas li { display: inline-flex; align-items: center; gap: .6rem; min-width: 0; }
  .migas li + li::before { content: "/"; color: var(--c-primario); }
  .migas a { text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { color: var(--c-primario); }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; padding-top: 1.5rem; align-items: center; }
  .ficha-titulo { font-size: clamp(2.2rem, 8vw, 4.5rem); overflow-wrap: anywhere; }
  .ficha-precio { margin-top: 1.25rem; display: inline-block; font-family: var(--fuente-titulos); font-weight: 900; font-size: 1.4rem; text-transform: uppercase; color: var(--c-primario); }
  .ficha-foto { border: 3px solid var(--c-fondo); box-shadow: 10px 10px 0 var(--c-primario); }
  .ficha-icono { display: none; }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.1rem; }
  .ficha-detalle p + p { margin-top: 1.15rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.25rem; align-content: start; }
  .ficha-datos > div { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-top: 1px solid var(--linea); }
  .ficha-datos { margin-top: .75rem; }
  .ficha-datos dt { font-weight: 800; text-transform: uppercase; font-size: .8rem; letter-spacing: .06em; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-caja { display: grid; gap: .9rem; padding: 1.6rem 1.4rem; }
  .ficha-caja-titulo { font-family: var(--fuente-titulos); font-weight: 900; font-size: 1.4rem; text-transform: uppercase; line-height: 1.05; }
  .ficha-caja .btn-sec { display: inline-flex; align-items: center; justify-content: center; }
  .ficha-wa { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-galeria li { border: 3px solid var(--c-texto); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .75rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra:hover { border-left-color: var(--c-texto); }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-texto); outline-offset: 2px; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-ver { display: inline-flex; align-items: center; gap: .3rem; margin-top: auto; font-weight: 900; font-size: .85rem; text-transform: uppercase; letter-spacing: .05em; }
  @media (min-width: 1024px) {
    .ficha-hero--foto { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 4.5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6rem; }
  }
</style>
