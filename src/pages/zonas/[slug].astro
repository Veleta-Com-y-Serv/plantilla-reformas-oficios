---
// Página de una zona con `texto` (src/lib/paginas.ts, sección `zonas`): /zonas/<slug>/.
// Estilo contundente: banda negra en diagonal con migas, «Reformas en <zona>» (`titulo_pagina` de la sección, con
// {zona}), la entrada (`texto_pagina`) y los botones; el texto propio de la zona junto a la foto (la de la zona o la
// de la sección); los servicios de la web en tarjetas (los que tienen ficha, enlazados); los trabajos cuyo `lugar`
// nombra la zona (antes y después); hasta tres opiniones (primero las que nombran la zona); la banda amarilla de
// presupuesto y las otras zonas con página.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { enlaceDe, introZona, resumen, tituloZona, trabajosEn, zonasConPagina } from '../../lib/paginas';
import type { Zona } from '../../lib/paginas';
import { jsonLdMigas, jsonLdZona, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return zonasConPagina().map((z) => ({ params: { slug: z.slug }, props: { z } }));
}

interface Props { z: Zona }
const { z } = Astro.props;
const base = urlBase(Astro.site);
const titulo = tituloZona(z);
const intro = introZona(z);
const nombreSeccion = String(z.seccion.antetitulo || z.seccion.titulo || 'Zonas').trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${z.idSeccion}` },
  { nombre: z.nombre, ruta: z.url },
];
const c = site.contacto;
const foto = z.imagen || String(z.seccion.imagen || '');
const servicios = seccion('servicios');
const listaServicios = servicios ? servicios.items.filter((it) => it?.titulo) : [];
const trabajos = trabajosEn(z.nombre).slice(0, 4);
const opinionesSec = seccion('opiniones');
const todas = opinionesSec ? opinionesSec.testimonios.filter((t) => t?.texto) : [];
const nombra = (t: { texto: string; nota?: string }) => `${t.texto} ${t.nota ?? ''}`.toLowerCase().includes(z.nombre.toLowerCase());
const opiniones = [...todas.filter(nombra), ...todas.filter((t) => !nombra(t))].slice(0, 3);
const presupuesto = seccion('presupuesto') ? '/#presupuesto' : site.boton_cabecera?.url || '/#contacto';
const textoPresupuesto = site.boton_cabecera?.texto || 'Pide presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero presupuesto para una obra en ${z.nombre}`);
const otras = zonasConPagina().filter((x) => x !== z);
---

<Base titulo={titulo} descripcion={resumen(z.texto[0] ?? intro)} imagen={foto} ld={[jsonLdMigas(base, migas), jsonLdZona(base, z)]}>
  <section class="banda-oscura diagonal-abajo">
    <div class="contenedor pt-6 md:pt-8">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class="pt-6 pb-4 max-w-4xl">
        <p class="antetitulo inline-flex items-center gap-1.5"><Icono nombre="mapa" tam={14} /> {z.nombre}</p>
        <h1 class="titulo-seccion zona-titulo">{titulo}</h1>
        {intro && <p class="titular-texto max-w-2xl">{intro}</p>}
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn" href={presupuesto}>{textoPresupuesto}</a>
          {c.telefono && <a class="btn-sec inline-flex items-center gap-2" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class:list={['contenedor grid items-center gap-10', { 'lg:grid-cols-[1.1fr_1fr] lg:gap-16': foto }]}>
      <div class="texto-largo zona-texto">
        {z.texto.map((p) => <p>{p}</p>)}
      </div>
      {foto && <Imagen src={foto} alt={titulo} ancho={1000} alto={750} class="aspect-[4/3] w-full border-[3px] border-texto object-cover shadow-[10px_10px_0_var(--c-primario)]" />}
    </div>
  </section>

  {listaServicios.length > 0 && (
    <section class="seccion banda-gris">
      <div class="contenedor">
        <Titular antetitulo={servicios?.antetitulo} titulo={`Qué hacemos en ${z.nombre}`} />
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {listaServicios.map((it) => (
            <li class="tarjeta zona-servicio grid grid-cols-[auto_1fr] items-start gap-x-4 gap-y-1 sm:flex sm:flex-col sm:gap-3">
              <span class="icono-caja row-span-2"><Icono nombre={it.icono} /></span>
              <h3 class="text-base md:text-lg">{enlaceDe(it) ? <a href={enlaceDe(it)} class="zona-enlace">{it.titulo}</a> : it.titulo}</h3>
              {it.texto && <p class="text-[.95rem] leading-snug opacity-80">{it.texto}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {trabajos.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <Titular antetitulo="Trabajos hechos" titulo={`Obras en ${z.nombre}`} />
        <ul class="grid gap-8 md:grid-cols-2">
          {trabajos.map((t) => (
            <li class="border-[3px] border-texto">
              {(t.imagen || t.imagen_antes) && <Imagen src={t.imagen || t.imagen_antes} alt={t.titulo} ancho={1200} alto={675} class="aspect-[16/9] w-full object-cover" />}
              <div class="p-5">
                <h3 class="text-lg md:text-xl">{t.titulo}</h3>
                {t.lugar && <p class="mt-1 flex items-center gap-1.5 text-sm font-bold uppercase tracking-wide opacity-75"><Icono nombre="mapa" tam={16} />{t.lugar}</p>}
                {t.texto && <p class="mt-3 opacity-85">{t.texto}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {opiniones.length > 0 && (
    <section class="seccion banda-gris">
      <div class="contenedor">
        <Titular antetitulo={opinionesSec?.antetitulo} titulo={opinionesSec?.titulo} />
        <ul class="grid gap-4 md:grid-cols-3">
          {opiniones.map((t) => (
            <li class="tarjeta">
              <span class="zona-comilla" aria-hidden="true">“</span>
              <blockquote class="mt-1 text-[1.02rem] leading-relaxed">{t.texto}</blockquote>
              <p class="mt-5 text-sm font-black uppercase">{t.autor}</p>
              {t.nota && <p class="text-sm opacity-70">{t.nota}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="seccion banda-primaria">
    <div class="contenedor grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div>
        <p class="antetitulo">Presupuesto gratis</p>
        <h2 class="titulo-seccion">¿Tienes una obra en {z.nombre}?</h2>
        <p class="titular-texto">Vamos a verla, medimos y te damos el precio cerrado por escrito.</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a class="btn-sec" href={presupuesto}>{textoPresupuesto}</a>
        {wa && <a class="btn-sec inline-flex items-center gap-2" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
      </div>
    </div>
  </section>

  {otras.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <h2 class="text-xl">También trabajamos en</h2>
        <ul class="mt-5 flex flex-wrap gap-2.5">
          {otras.map((o) => <li><a class="zona-otra" href={o.url}><Icono nombre="mapa" tam={16} /> {o.nombre}</a></li>)}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .6rem; font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  .migas li { display: inline-flex; align-items: center; gap: .6rem; min-width: 0; }
  .migas li + li::before { content: "/"; color: var(--c-primario); }
  .migas a { text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { color: var(--c-primario); }
  .migas [aria-current] { opacity: .7; }
  .zona-titulo { font-size: clamp(2.2rem, 8vw, 4.5rem); overflow-wrap: anywhere; }
  .zona-texto { font-size: 1.15rem; max-width: 44rem; }
  .zona-texto p + p { margin-top: 1rem; }
  .zona-servicio { position: relative; }
  .zona-enlace { text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: var(--c-primario); text-underline-offset: 4px; }
  .zona-enlace::after { content: ""; position: absolute; inset: 0; }
  .zona-comilla { display: block; font-family: var(--fuente-titulos); font-size: 3.5rem; line-height: .8; color: var(--c-primario); }
  .zona-otra { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.75rem; padding: .5rem .8rem; border: 2px solid var(--c-texto); font-weight: 800; text-transform: uppercase; font-size: .85rem; letter-spacing: .03em; text-decoration: none; }
  .zona-otra:hover { background: var(--c-primario); color: var(--sobre-primario); border-color: var(--c-primario); }
</style>
