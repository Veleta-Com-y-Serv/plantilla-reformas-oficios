---
// Pie oscuro con franja de obra arriba: marca y teléfono en grande, contacto, menú y redes desde site.yaml.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie es true (plan gratis).
// En móvil añade la barra inferior fija con «Llamar» y «WhatsApp» (solo si hay teléfono o WhatsApp).
import { site, tel, mapa, whatsapp } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'obra' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
---

<footer class={`pie pie--${variante} banda-oscura`}>
  <div class="franja-obra" aria-hidden="true"></div>
  <div class="pie-cuerpo">
    <div class="contenedor pie-rejilla">
      <div class="pie-marca">
        <p class="pie-nombre">{site.nombre}</p>
        {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
        {c.telefono && <a class="pie-telefono" href={tel(c.telefono)}>{c.telefono}</a>}
        {
          redes.length > 0 && (
            <ul class="pie-redes">
              {redes.map(([red, url]) => (
                <li>
                  <a href={url} rel="noopener" target="_blank" aria-label={red}>
                    <Icono nombre={red} tam={20} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div>
        <p class="pie-titulo">Contacto</p>
        <ul class="pie-lista">
          {c.email && <li><a class="break-all" href={`mailto:${c.email}`}>{c.email}</a></li>}
          {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp {c.whatsapp}</a></li>}
          {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
          {c.horario && <li>{c.horario}</li>}
        </ul>
      </div>
      {
        site.menu.length > 0 && (
          <div>
            <p class="pie-titulo">Web</p>
            <ul class="pie-lista">
              {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
            </ul>
          </div>
        )
      }
    </div>
    <div class="contenedor pie-legal">
      <span>© {anio} {site.nombre}</span>
      <a href="/aviso-legal">Aviso legal y privacidad</a>
      {
        site.marca_pie && (
          <span class="pie-noexpertise">
            Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
          </span>
        )
      }
    </div>
  </div>
</footer>
{
  (c.telefono || c.whatsapp) && (
    <nav class="barra-movil" aria-label="Contacto rápido">
      {c.telefono && (
        <a class="barra-movil-llamar" href={tel(c.telefono)}>
          <Icono nombre="telefono" tam={20} />
          Llamar
        </a>
      )}
      {c.whatsapp && (
        <a class="barra-movil-whatsapp" href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">
          <Icono nombre="whatsapp" tam={20} />
          WhatsApp
        </a>
      )}
    </nav>
  )
}
