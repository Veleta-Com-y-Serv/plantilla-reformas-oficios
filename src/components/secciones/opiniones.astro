---
// Opiniones: `testimonios: [{texto, autor, nota}]` en tarjetas con borde grueso y comilla amarilla.
// `nota` opcional (p. ej. el trabajo y el pueblo). Sin opiniones solo se pinta el titular (o nada si tampoco hay).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const hayAlgo = s && (s.testimonios.length > 0 || s.titulo || s.texto);
---

{
  s && hayAlgo && (
    <Seccion id={Astro.props.id} class="banda-gris">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      {s.testimonios.length > 0 && (
        <ul class="grid gap-4 md:grid-cols-3">
          {s.testimonios.map((t) => (
            <li class="tarjeta opinion">
              <span class="opinion-comilla" aria-hidden="true">“</span>
              <blockquote class="mt-1 text-[1.02rem] leading-relaxed">{t.texto}</blockquote>
              <p class="mt-5 font-display text-sm font-black uppercase">{t.autor}</p>
              {t.nota && <p class="text-sm opacity-70">{t.nota}</p>}
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}

<style>
  .opinion { display: flex; flex-direction: column; }
  .opinion-comilla { font-family: var(--fuente-titulos); font-size: 4rem; line-height: .8; height: 2.2rem; color: var(--c-primario); -webkit-text-stroke: 1px var(--c-texto); }
  .opinion blockquote { flex: 1; }
</style>
