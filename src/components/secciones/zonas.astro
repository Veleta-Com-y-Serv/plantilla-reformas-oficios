---
// Zonas de trabajo: `texto` con el radio de actuación y `items` (titulo = localidad) como etiquetas cuadradas.
// `imagen` opcional (un plano de la comarca) a la derecha.
import { seccion } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <div class:list={['grid items-center gap-10', { 'lg:grid-cols-[1.1fr_1fr] lg:gap-16': s.imagen }]}>
        <div>
          <Titular class="!mb-8" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {s.items.length > 0 && (
            <ul class="flex flex-wrap gap-2.5">
              {s.items.map((it) => (
                <li class="zona">
                  <Icono nombre="mapa" tam={16} class="shrink-0" />
                  {it.titulo}
                </li>
              ))}
            </ul>
          )}
          {s.cta && (
            <p class="mt-8">
              <a class="btn" href={s.cta.url}>{s.cta.texto}</a>
            </p>
          )}
        </div>
        {s.imagen && (
          <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1000} alto={750} class="aspect-[4/3] w-full border-[3px] border-texto object-cover shadow-[10px_10px_0_var(--c-primario)]" />
        )}
      </div>
    </Seccion>
  )
}

<style>
  .zona { display: inline-flex; align-items: center; gap: .4rem; padding: .5rem .8rem; border: 2px solid var(--c-texto); font-weight: 800; text-transform: uppercase; font-size: .85rem; letter-spacing: .03em; }
  .zona:first-child { background: var(--c-primario); color: var(--sobre-primario); border-color: var(--c-primario); }
</style>
